---
import type { Projecte } from '../data/projectes'
interface Props {
  projecte: Projecte
}
const { projecte } = Astro.props
---

<li class="punt bg-soft p-6"><h3 class="text-2xl md:text-3xl font-[500] leading-tight mb-3">{projecte.titol}</h3><p class="text-lg leading-relaxed">{projecte.resum}</p></li>
