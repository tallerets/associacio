---
import Favicon from '../components/Favicon.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/main.css'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
const url = new URL(Astro.url.pathname, Astro.site).toString()
---

<!doctype html>
<html lang="ca" dir="ltr" class="scroll-smooth bg-dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <Favicon />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body class="font-serif bg-soft text-dark relative overflow-x-hidden">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <style is:global>
      .page-padding {
        @apply px-4 sm:px-6 md:px-8;
      }
      .c-button {
        @apply inline-block border-2 rounded-lg text-center text-xl md:text-2xl px-4 pb-2 pt-[0.4rem] hover:-rotate-3 hover:border-red hover:text-red transition-all font-[500];
      }
      .titol-seccio {
        @apply text-4xl md:text-5xl text-center md:leading-tight font-[500] mb-10 md:mb-16;
      }
      .punt {
        @apply border-2 border-dashed border-dark rounded-lg;
      }
      .etiqueta {
        @apply inline-block font-mono text-sm uppercase tracking-wide border-2 rounded-full px-3 py-0.5;
      }
    </style>
  </body>
</html>
