---
import Layout from '../../layouts/BaseLayout.astro'
import { projectes, type Projecte } from '../../data/projectes'
import { entitat } from '../../data/entitat'

export function getStaticPaths() {
  return projectes.map((p) => ({ params: { slug: p.slug }, props: { p } }))
}

const { p } = Astro.props as { p: Projecte }
const altres = projectes.filter((x) => x.slug !== p.slug).slice(0, 3)
---

<Layout title={`${p.titol} · Tallerets, associació`} description={p.resum}>
  <article class="page-padding mx-auto pt-8 pb-24 max-w-4xl">
    <a href="/#projectes" class="font-mono text-sm uppercase tracking-wide">← Tots els projectes</a>

    <div class="flex flex-wrap gap-2 mt-8 mb-6">
      {
        p.estats.map((e) => (
          <span class={`etiqueta ${e === 'Busquem finançament' ? 'border-red text-red' : 'border-dark'}`}>
            {e}
          </span>
        ))
      }
    </div>

    <h1 class="text-4xl md:text-6xl font-[500] md:leading-tight mb-6">{p.titol}</h1>
    <p class="text-2xl md:text-3xl leading-snug mb-12">{p.resum}</p>

    <div class="fitxa">
      <h2>Quina necessitat atenem</h2>
      <p>{p.necessitat}</p>

      <h2>A qui s’adreça</h2>
      <p>{p.destinataries}</p>

      <h2>Què fem</h2>
      <ul>{p.activitats.map((a) => <li>{a}</li>)}</ul>

      <h2>Amb qui</h2>
      <ul>{p.aliances.map((a) => <li>{a}</li>)}</ul>

      <h2>Calendari</h2>
      <p>{p.calendari}</p>

      <h2>Com mesurem els resultats</h2>
      <ul>{p.indicadors.map((a) => <li>{a}</li>)}</ul>

      <h2>Finançament</h2>
      <p>{p.financament}</p>
    </div>

    <div class="punt p-8 mt-16">
      <p class="text-2xl font-[500] mb-4">Vols donar suport a aquest projecte?</p>
      <a
        class="c-button bg-red border-red text-soft hover:bg-soft"
        href={`mailto:${entitat.email}?subject=${encodeURIComponent(p.titol)}`}
      >
        Parlem-ne
      </a>
    </div>

    <h2 class="text-3xl font-[500] mt-20 mb-6">Altres projectes</h2>
    <ul class="space-y-3 text-xl">
      {altres.map((x) => <li><a class="link underline decoration-red decoration-2 underline-offset-4" href={`/projectes/${x.slug}`}>{x.titol}</a></li>)}
    </ul>
  </article>
</Layout>
